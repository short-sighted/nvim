{
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "  $0",
      "}"
    ],
    "description": "TypeScript interface"
  },
  "Async function": {
    "prefix": "afn",
    "body": [
      "async function ${1:name}(${2:args}): Promise<${3:void}> {",
      "  $0",
      "}"
    ],
    "description": "Typed async function"
  }
}
